# PostgreSQL connection parts. Keep the password here, never in source code.
# For serverless runtime, use Supabase's transaction-pooler host, port, and user.
DATABASE_HOST="aws-0-[region].pooler.supabase.com"
DATABASE_PORT="6543"
DATABASE_NAME="postgres"
DATABASE_USER="postgres.[project-ref]"
DATABASE_PASSWORD=""

# Supabase Auth. Use the publishable/anon key only; never put a service-role key in the frontend.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
# Optional legacy fallback if the project uses an anon key.
# SUPABASE_ANON_KEY=""

# Optional Prisma migration connection overrides. If omitted, DATABASE_* is used.
DIRECT_DATABASE_HOST="db.[project-ref].supabase.co"
DIRECT_DATABASE_PORT="5432"
DIRECT_DATABASE_NAME="postgres"
DIRECT_DATABASE_USER="postgres"
# DIRECT_DATABASE_PASSWORD falls back to DATABASE_PASSWORD.

# Frontend-to-backend URL
VITE_API_URL="http://localhost:3000/api"
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Backend CORS allow-list
FRONTEND_URL="http://localhost:5173"

# Server-side catalogue providers. These values are read only by the backend.
# Get an API Read Access Token from TMDB account settings; the API key is optional if using the token.
TMDB_API_READ_ACCESS_TOKEN=""
# Optional TMDB v3 API key fallback.
TMDB_API_KEY=""
# Provider identification only; replace YOUR_PROJECT_OR_SHARED_CONTACT_URL with a public project URL.
MUSICBRAINZ_USER_AGENT="Libraria/0.1.0 (YOUR_PROJECT_OR_SHARED_CONTACT_URL)"
# Optional OAuth access token for MusicBrainz endpoints that require user authentication.
# Public catalogue search/lookups do not require OAuth. Use an access token here, not the client secret.
MUSICBRAINZ_ACCESS_TOKEN=""
OPEN_LIBRARY_USER_AGENT="Libraria/0.1.0 (YOUR_PROJECT_OR_SHARED_CONTACT_URL)"
